{
  "version": "1.2",
  "state": "Kogi",
  "country": "Nigeria",
  "map": {
    "boundary": "data/admin/kogi_state.geojson",
    "lga_boundaries": "data/admin/kogi_lgas.geojson",
    "tile_index": "data/tile_index.geojson"
  },
  "site_registry": {
    "provider": "Google Sheets via Apps Script",
    "public_api": "https://script.google.com/macros/s/AKfycbxQwLQvjV591q8JUCUsgi8_lkJL2rfeWvZCqReJ8zeU5YTufUASp-m9QFNT5TFsrk8/exec",
    "public_form": "https://docs.google.com/forms/d/e/1FAIpQLSc5u0zf5JcXUL-hwrUIPJuPV2g7TZSbsUqZA0p_Ja_3NL7yMg/viewform",
    "publish_rule": "Only Sites_Master records with portal_publish = Yes and valid coordinates are exposed.",
    "privacy_note": "Private submitter and reviewer fields are not exposed by the public API."
  },
  "change_layers": {
    "primary": {
      "id": "permanent",
      "label": "Strict permanent change",
      "tile_property": "permanent_path",
      "schema": "metadata/raster_schema.json"
    },
    "screening": {
      "id": "candidate",
      "label": "Potential / candidate change",
      "tile_property": "candidate_path",
      "schema": "metadata/raster_schema.json"
    }
  },
  "polygon_analysis": {
    "enabled": true,
    "engine": "browser",
    "libraries": [
      "Leaflet.Draw 1.0.4",
      "GeoTIFF.js 2.1.3",
      "Turf.js 7.2.0"
    ],
    "max_bbox_window_pixels": 4000000,
    "clip_to_processing_boundary": true,
    "edge_pixel_method": "fractional polygon-pixel intersection",
    "interior_pixel_area_method": "geodesic pixel polygon area",
    "coverage_note": "Polygons extending outside the Kogi processing boundary are clipped for change statistics and the coverage percentage is reported."
  },
  "report": {
    "primary_status_value": 1,
    "provisional_status_value": 2,
    "show_polygon_area": true,
    "show_changed_area": true,
    "show_percent_changed": true,
    "breakdowns": [
      "change_year",
      "baseline_class",
      "transition_code",
      "first_end_state",
      "final_2025_state",
      "persistence_years"
    ],
    "keep_2025_provisional_separate": true,
    "csv_download": true
  }
}